<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dl_warning_root"
    android:fillViewport="true"
    android:clickable="true"
    android:focusable="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="28dp">

        <!-- Shield status pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/dl_pill_shield"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dl_ring_center"
                android:backgroundTint="@color/dl_primary" />

            <TextView
                android:id="@+id/pillSprintLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.08"
                android:text="DEEP WORK • SPRINT"
                android:textColor="@color/dl_primary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Frosted vault with the locked app icon -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/dl_vault">

            <ImageView
                android:id="@+id/vaultIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="@string/dl_locked_app_icon" />

            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/dl_lock_badge"
                android:gravity="center"
                android:text="🔒"
                android:textSize="11sp" />
        </FrameLayout>

        <!-- Main glass card -->
        <LinearLayout
            android:id="@+id/warningCardLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/dl_glass_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingVertical="22dp">

            <!-- Countdown ring -->
            <FrameLayout
                android:id="@+id/timerTrigger"
                android:layout_width="150dp"
                android:layout_height="150dp">

                <com.jainam.studentos.CountdownRingView
                    android:id="@+id/countdownRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/ringCenterIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡️"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/countdownText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:textColor="@color/dl_on_surface"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/timerStatusLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="AUTO-RETURN"
                        android:textColor="@color/dl_primary"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/motivationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Flow Shield Active"
                android:textColor="@color/dl_on_surface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/appNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/dl_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.25"
                android:textColor="@color/dl_on_surface_variant"
                android:textSize="12sp" />

            <!-- Mindful breathing box (hidden until requested) -->
            <LinearLayout
                android:id="@+id/breathBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/dl_btn_secondary"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🌿  Mindful Reset"
                        android:textColor="@color/dl_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/closeBreathBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="6dp"
                        android:text="✕"
                        android:textColor="@color/dl_on_surface_variant"
                        android:textSize="13sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginTop="6dp">

                    <View
                        android:id="@+id/breathBubble"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:background="@drawable/dl_breath_bubble" />

                    <TextView
                        android:id="@+id/breathText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Inhale"
                        android:textColor="@color/dl_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Inhale clarity, exhale distraction."
                    android:textColor="@color/dl_on_surface_variant"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Primary action -->
            <Button
                android:id="@+id/returnButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/dl_btn_primary"
                android:text="⚡  Re-enter Deep Work Sprint"
                android:textAllCaps="false"
                android:textColor="@color/dl_on_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Secondary actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/breathButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/dl_btn_secondary"
                    android:text="🌿 3 Breaths"
                    android:textAllCaps="false"
                    android:textColor="@color/dl_on_surface"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/pauseButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/dl_btn_secondary"
                    android:text="⏸ Pause"
                    android:textAllCaps="false"
                    android:textColor="@color/dl_on_surface"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Hold for emergency pass -->
            <FrameLayout
                android:id="@+id/holdPassContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/dl_btn_hold">

                <View
                    android:id="@+id/holdProgressBar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="#334EDEA3" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/holdLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⏳ Hold 10s for 5m Pass"
                        android:textColor="@color/dl_on_surface_variant"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/holdTimerBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/dl_btn_secondary"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="10s"
                        android:textColor="@color/dl_primary"
                        android:textSize="10sp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/dismissHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="#6688AACC"
                android:textSize="10sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/breakButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/dl_btn_secondary"
                android:text="Take a Break"
                android:textAllCaps="false"
                android:textColor="@color/dl_on_surface_variant"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Session stats footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/dl_footer_stats"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/streakText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 0"
                    android:textColor="@color/dl_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="FLOW STREAK"
                    android:textColor="@color/dl_on_surface_variant"
                    android:textSize="8sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/blockedText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️ 0"
                    android:textColor="@color/dl_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="TODAY"
                    android:textColor="@color/dl_on_surface_variant"
                    android:textSize="8sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/savedText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ 0m"
                    android:textColor="@color/dl_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="ELAPSED"
                    android:textColor="@color/dl_on_surface_variant"
                    android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hidden views kept for behaviour parity -->
        <TextView
            android:id="@+id/elapsedText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/remainingText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/distractionText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/distractionLabel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
