{
  "name": "student-os",
  "version": "1.2.0",
  "private": true,
  "description": "Offline-first, privacy-first study workspace — focus timer, tasks, habits, planner and analytics in one calm app.",
  "license": "MIT",
  "author": "Jainam Karnawat <jainamkarnawat8@gmail.com>",
  "homepage": "https://github.com/jainam6610/student-os#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jainam6610/student-os.git"
  },
  "bugs": {
    "url": "https://github.com/jainam6610/student-os/issues"
  },
  "keywords": [
    "student",
    "productivity",
    "study",
    "focus",
    "pomodoro",
    "habit-tracker",
    "planner",
    "nextjs",
    "react",
    "typescript",
    "pwa",
    "offline-first",
    "capacitor",
    "android"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve@latest out",
    "lint": "eslint .",
    "check": "tsc --noEmit && eslint . && next build",
    "check:types": "tsc --noEmit",
    "check:lint": "eslint .",
    "verify": "node scripts/verify-release.mjs",
    "cap:sync": "pnpm build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "pnpm build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "dexie": "^4.4.6",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.564.0",
    "next": "16.2.6",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "2.15.0",
    "tailwind-merge": "^3.3.1",
    "three": "^0.184.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3"
  }
}
